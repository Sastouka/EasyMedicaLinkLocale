    <style>
        /* -----------------------------------------------------------
           PALETTE DE COULEURS & VARIABLES
        ----------------------------------------------------------- */
        :root {
            /* Couleurs principales */
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --primary: #5a67d8;
            --primary-dark: #4c51bf;
            --primary-light: #c3dafe;
            --primary-glow: rgba(102, 126, 234, 0.25);
            
            /* Couleurs secondaires */
            --secondary-gradient: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            --secondary: #2d3748;
            --secondary-dark: #1a202c;
            --secondary-light: #4a5568;
            
            /* Accents */
            --accent-teal: #0bc5ea;
            --accent-coral: #ed64a6;
            --accent-emerald: #48bb78;
            --accent-amber: #ed8936;
            
            /* Neutres */
            --text-main: #2d3748;
            --text-light: #4a5568;
            --text-lighter: #a0aec0;
            --text-white: #ffffff;
            --text-white-muted: #e2e8f0;
            
            /* Backgrounds */
            --bg-body: #f7fafc;
            
            /* Effets */
