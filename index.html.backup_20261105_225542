                    currency: 'MAD'
                });
            }
            setTimeout(() => { 
                window.location.href = DOWNLOAD_URL; 
            }, 300);
        }

        // --- TRACKING WHATSAPP ---
        function trackWhatsApp() {
            if (typeof fbq === 'function') {
                fbq('track', 'Contact', {content_name: 'WhatsApp Support'});
            }
        }

        // --- TRACKING GUIDE ---
        function trackGuide(event) {
            if (typeof fbq === 'function') {
                fbq('track', 'ViewContent', {content_name: 'Guide Utilisation', content_category: 'Help'});
            }
        }

        // --- COOKIES ---
        function checkCookieConsent() {
            if (!localStorage.getItem('cookieConsent')) {
                setTimeout(() => { document.getElementById('cookieBanner').classList.add('show'); }, 1000);
            }
        }
        function acceptCookies() {
            localStorage.setItem('cookieConsent', 'true');
            document.getElementById('cookieBanner').classList.remove('show');
        }

        // --- DRAG & DROP ---
        function makeDraggable(elementId) {
            const elmnt = document.getElementById(elementId);
            let pos1=0, pos2=0, pos3=0, pos4=0;
            let isDragging = false;
            elmnt.onmousedown = dragMouseDown;
            elmnt.addEventListener('touchstart', dragMouseDown, {passive: false});
            function dragMouseDown(e) {
                if(e.target.closest('a') && e.type !== 'touchstart') return;
                const evt = e.type === 'touchstart' ? e.touches[0] : e;
                pos3 = evt.clientX; pos4 = evt.clientY; isDragging = false; 
                document.onmouseup = closeDragElement; document.onmousemove = elementDrag;
                document.addEventListener('touchend', closeDragElement); document.addEventListener('touchmove', elementDrag, {passive: false});
            }
            function elementDrag(e) {
                const evt = e.type === 'touchmove' ? e.touches[0] : e;
                if(!isDragging) { isDragging = true; elmnt.setAttribute('data-dragging', 'true'); }
                if(e.cancelable) e.preventDefault();
                pos1 = pos3 - evt.clientX; pos2 = pos4 - evt.clientY; pos3 = evt.clientX; pos4 = evt.clientY;
                elmnt.style.top = (elmnt.offsetTop - pos2) + "px"; elmnt.style.left = (elmnt.offsetLeft - pos1) + "px";
                elmnt.style.bottom = 'auto'; elmnt.style.right = 'auto';
            }
            function closeDragElement() {
                document.onmouseup = null; document.onmousemove = null;
                document.removeEventListener('touchend', closeDragElement); document.removeEventListener('touchmove', elementDrag);
                setTimeout(() => { elmnt.setAttribute('data-dragging', 'false'); }, 100);
            }
        }

        // --- MODALES (Privacy/Terms) ---
        function openModal(id, e) { if(e) e.preventDefault(); document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // --- INITIALISATION GENERALE ---
        document.addEventListener('DOMContentLoaded', () => {
            makeDraggable("dragWhatsapp");
            makeDraggable("dragDownloads");
            checkCookieConsent();

            let seconds = 0;
            setInterval(() => {
                seconds += 10;
                if (typeof fbq === 'function') {
                    if (seconds === 10 || seconds === 30 || seconds === 60 || seconds === 120) {
                        fbq('trackCustom', 'TimeOnPage', { seconds: seconds });
                    }
                }
            }, 10000);

            // Activation du zoom sur les images
            const images = document.querySelectorAll('.hero-main-screenshot img, .doc-item img, .img-col img, .admin-card img, .app-screen');
            images.forEach(img => {
                img.classList.add('zoomable-cursor');
                img.onclick = function() {
                    openLightbox(this.src);
                };
            });
        });
    </script>
</body>
