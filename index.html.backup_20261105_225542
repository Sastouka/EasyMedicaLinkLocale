    <script>
        // --- Lien de téléchargement unique (ZIP) ---
        const DOWNLOAD_URL = 'https://github.com/Sastouka/EasyMedicaLinkLocale/releases/download/v1.0.0/EasyMedicaLink.zip';

        // Suivi du clic APK Android (le téléchargement reste un lien direct).
        function trackApkDownload(position) {
            if (typeof fbq === 'function') {
                fbq('track', 'Lead', {
                    content_name: 'EasyMedicaLink.apk',
                    content_category: 'Android App Download',
                    value: 0.00,
                    currency: 'MAD'
                });
                fbq('trackCustom', 'AndroidAPKDownloadClick', {
                    placement: position || 'unknown'
                });
            }
        }

        // --- LOGIQUE VIDÉO CLICK-TO-LOAD ---
        function loadVideo(el) {
            el.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/aaIg6gDj9b0?autoplay=1&rel=0&modestbranding=1" title="Démonstration EasyMedicaLink" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"></iframe>';
            setTimeout(() => {
                document.getElementById('localVideoHelp').style.display = 'block';
            }, 1500);
        }

        // --- LOGIQUE LIGHTBOX AVEC PINCH-TO-ZOOM (TOUCH) ---
        let scale = 1;
        let isDragging = false;
        let startX, startY;
        let currentTranslateX = 0, currentTranslateY = 0;
        let prevTranslateX = 0, prevTranslateY = 0;
        let initialPinchDistance = 0;
        let initialScale = 1;

        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightboxImg');
        const container = document.getElementById('lightboxContainer');

        function openLightbox(src) {
            img.src = src;
            lightbox.style.display = 'flex';
            resetZoom();
        }

        function closeLightbox() {
            lightbox.style.display = 'none';
        }

        function updateTransform() {
            img.style.transform = `translate(${currentTranslateX}px, ${currentTranslateY}px) scale(${scale})`;
        }

        function zoomImage(amount) {
            const oldScale = scale;
            scale += amount;
            if (scale < 0.5) scale = 0.5;
            if (scale > 4) scale = 4;
            if(Math.abs(scale - 1) < 0.1) {
                resetZoom();
            } else {
                updateTransform();
            }
        }

        function resetZoom() {
            scale = 1;
            currentTranslateX = 0; currentTranslateY = 0;
            prevTranslateX = 0; prevTranslateY = 0;
            updateTransform();
        }

        // Gestion souris
        container.addEventListener('mousedown', (e) => {
            if(scale <= 1) return; 
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            container.classList.add('grabbing');
            img.style.transition = 'none'; 
        });

        container.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            e.preventDefault();
            const xDiff = e.clientX - startX;
            const yDiff = e.clientY - startY;
            currentTranslateX = prevTranslateX + xDiff;
            currentTranslateY = prevTranslateY + yDiff;
            updateTransform();
        });

        window.addEventListener('mouseup', () => {
            if(isDragging) {
                isDragging = false;
                prevTranslateX = currentTranslateX;
                prevTranslateY = currentTranslateY;
                container.classList.remove('grabbing');
                img.style.transition = 'transform 0.1s ease-out'; 
            }
        });

        container.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (e.deltaY < 0) zoomImage(0.1);
            else zoomImage(-0.1);
        }, { passive: false });

        // Gestion tactile
        function getDistance(touches) {
            return Math.hypot(
                touches[0].pageX - touches[1].pageX,
                touches[0].pageY - touches[1].pageY
            );
        }

        container.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
                e.preventDefault();
                initialPinchDistance = getDistance(e.touches);
                initialScale = scale;
            } else if (e.touches.length === 1 && scale > 1) {
                isDragging = true;
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
                img.style.transition = 'none';
            }
        }, { passive: false });

        container.addEventListener('touchmove', (e) => {
            if (e.touches.length === 2) {
                e.preventDefault();
                const currentDistance = getDistance(e.touches);
                if (initialPinchDistance > 0) {
                    const diff = currentDistance / initialPinchDistance;
                    scale = initialScale * diff;
                    if (scale < 0.5) scale = 0.5;
                    if (scale > 4) scale = 4;
                    updateTransform();
                }
            } else if (e.touches.length === 1 && isDragging) {
                e.preventDefault();
                const xDiff = e.touches[0].clientX - startX;
                const yDiff = e.touches[0].clientY - startY;
                currentTranslateX = prevTranslateX + xDiff;
                currentTranslateY = prevTranslateY + yDiff;
                updateTransform();
            }
        }, { passive: false });

        container.addEventListener('touchend', (e) => {
            if (isDragging) {
                isDragging = false;
                prevTranslateX = currentTranslateX;
                prevTranslateY = currentTranslateY;
                img.style.transition = 'transform 0.1s ease-out';
            }
            if (e.touches.length < 2) {
                initialPinchDistance = 0;
            }
        });

        // --- GESTION DU TÉLÉCHARGEMENT (MODALE) AVEC PIXEL META ---
        function openDownloadModal(event) {
