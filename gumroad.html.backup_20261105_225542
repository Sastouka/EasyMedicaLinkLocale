<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gumroad Cover - EasyMedicaLink</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* Réinitialisation de base */
        body {
            margin: 0;
            padding: 40px;
            background-color: #1a1a2e; /* Fond très sombre pour le navigateur */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* LE CONTENEUR PRINCIPAL GUMROAD (1280x720 exact) */
        #gumroad-cover {
            width: 1280px;
            height: 720px;
            /* Dégradé bleu/vert très moderne et médical */
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            position: relative;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            color: white;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            display: flex;
        }

        /* ==== COLONNE GAUCHE (TEXTE) ==== */
        .left-panel {
            width: 45%;
            padding: 70px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            z-index: 10;
        }

        .header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .logo {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        .header h1 {
            font-size: 52px;
            font-weight: 900;
            margin: 0;
            line-height: 1;
            background: linear-gradient(to right, #ffffff, #a5f3fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 24px;
            font-weight: 500;
            color: #bae6fd; /* Bleu clair */
            margin-bottom: 40px;
            line-height: 1.4;
        }

        /* Liste des avantages */
        .features {
            list-style: none;
            padding: 0;
            margin: 0 0 50px 0;
        }

        .features li {
            font-size: 20px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            color: #f8fafc;
        }

        /* Coche verte pour la liste */
        .features li::before {
            content: '✓';
            color: #10b981;
            font-weight: 900;
            font-size: 24px;
            margin-right: 15px;
            background: rgba(16, 185, 129, 0.1);
            width: 35px;
            height: 35px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
        }

        /* Badges de prix/licence */
        .badges-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }

        .badge {
            padding: 12px 25px;
            border-radius: 50px;
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .badge-orange {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            border: 2px solid #fcd34d;
        }

        .badge-green {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: 2px solid #6ee7b7;
        }

        /* ==== COLONNE DROITE (IMAGES MULTIPLES) ==== */
        .right-panel {
            width: 55%;
            position: relative;
        }

        /* Style commun pour toutes les captures d'écran */
        .screenshot {
            position: absolute;
            border-radius: 12px;
            box-shadow: -15px 25px 45px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            transition: transform 0.3s ease;
        }

        /* Décoration d'arrière plan (cercles flous) */
        .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
        }

        /* Disposition spécifique de chaque image (effet de cascade) */
        
        /* Image 1 : Connexion (En haut, un peu cachée) */
        .img-1 {
            width: 500px;
            top: 20px;
            right: 150px;
            z-index: 1;
            opacity: 0.7;
            transform: rotate(4deg);
        }

        /* Image 2 : Admin bleue (Milieu droite) */
        .img-2 {
            width: 650px;
            top: 150px;
            right: -80px;
            z-index: 2;
            transform: rotate(-3deg);
        }

        /* Image 3 : Patients Rose (Milieu gauche) */
        .img-3 {
            width: 600px;
            top: 280px;
            right: 180px;
            z-index: 3;
            transform: rotate(2deg);
        }

        /* Image 4 : RDV (Au premier plan, bien mise en avant) */
        .img-4 {
            width: 700px;
            bottom: 30px;
            right: -30px;
            z-index: 4;
            transform: rotate(-2deg);
            border: 4px solid rgba(255,255,255,0.4);
            box-shadow: -20px 30px 60px rgba(0,0,0,0.6);
        }

    </style>
</head>
<body>

    <div id="gumroad-cover">
        
        <div class="glow" style="width: 400px; height: 400px; background: rgba(6, 182, 212, 0.3); top: -100px; right: -50px;"></div>
        <div class="glow" style="width: 500px; height: 500px; background: rgba(16, 185, 129, 0.2); bottom: -100px; left: 300px;"></div>

        <div class="left-panel">
            <div class="header">
                <img src="icon.png" class="logo" alt="Icone EasyMedicaLink">
                <h1>EasyMedica<br>Link</h1>
            </div>
            
            <p class="subtitle">La gestion complète de votre cabinet médical, sécurisée sur votre ordinateur.</p>
            
            <ul class="features">
                <li>100% Local & Confidentiel</li>
                <li>Dossiers, RDV & Facturation</li>
                <li>Assistant IA Médical Intégré</li>
                <li>Sans aucun abonnement mensuel</li>
            </ul>

            <div class="badges-container">
                <div class="badge badge-orange">💎 Licence à vie</div>
                <div class="badge badge-green">💶 Paiement unique </div>
            </div>
        </div>

        <div class="right-panel">
            <img src="10.png" class="screenshot img-1" alt="Connexion">
            <img src="8.png" class="screenshot img-2" alt="Administration">
            <img src="2.png" class="screenshot img-3" alt="Gestion des Patients">
            <img src="1-1.png" class="screenshot img-4" alt="Liste des Rendez-vous">
        </div>

    </div>

</body>
</html>